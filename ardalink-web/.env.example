# ArdaLink Web — environment template
# Copy to .env and fill in. Never commit .env.

# Backend API (ardalink-api)
VITE_API_BASE_URL=http://localhost:3000

# Africa's Talking (browser-side, public token only)
VITE_AFRICASTALKING_USERNAME=sandbox

# Maps
VITE_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Optional feature flags
VITE_FEATURE_COST_RAILS=1
VITE_FEATURE_SHARE_CALL_LINK=1