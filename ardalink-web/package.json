{
  "name": "ardalink-web",
  "version": "0.1.0",
  "private": true,
  "description": "ArdaLink Web — operator dashboard and public Talk app.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preinstall": "sh -c 'case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm\" >&2; exit 1 ;; esac'",
    "dev": "pnpm --filter dashboard run dev",
    "dev:talk": "pnpm --filter talk run dev",
    "build": "pnpm -r --filter \"./dashboard\" --filter \"./talk\" run build",
    "typecheck": "pnpm -r --filter \"./dashboard\" --filter \"./talk\" run typecheck",
    "lint": "pnpm -r --filter \"./dashboard\" --filter \"./talk\" run lint",
    "test": "pnpm -r --filter \"./dashboard\" --filter \"./talk\" run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.8.0",
    "typescript": "~5.9.0"
  },
  "dependencies": {
    "tw-animate-css": "^1.4.0",
    "wouter": "^3.3.5"
  }
}
