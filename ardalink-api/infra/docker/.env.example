# Local defaults — copy to .env and fill in real values for staging/prod.

# PostgreSQL
POSTGRES_PASSWORD=ardalink_dev_only

# Multi-tenant
JWT_SECRET=replace-with-32-plus-bytes-random
TENANT_ATTESTATION_SECRET=replace-with-32-plus-bytes-random-shared-with-engine
SESSION_SECRET=replace-with-32-plus-bytes-random

# Africa's Talking (use sandbox for dev)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_CALLER_ID=+254700000000

# Azure OpenAI (optional in dev; required for voice calls)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Google Earth Engine (optional in dev; required for live satellite ingest)
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY=
GEE_PROJECT=

# Historical baselines now live in the engine's Postgres
# (`gis_engine.baseline_*`); the Azure Cosmos DB client was retired
# 2026-07 and no COSMOS_DB_* env vars are read.

# Scheduler (off in dev)
INGEST_SCHEDULER_ENABLED=0

# Logging
LOG_LEVEL=INFO