# Local defaults — copy to .env and fill in real values for staging/prod.

# compose.prod.yml only (the pre-built-image hand-off stack) — which
# tag of munene1212/ardalink-{api,engine,web} to pull. Defaults to
# `latest` if unset, which moves every time a new build is pushed;
# compose.prod.yml's own header recommends pinning to a dated release
# tag (e.g. 2026-08-10) for any real deployment instead. Not used by
# compose.yml (local dev builds from source).
ARDALINK_IMAGE_TAG=latest

# PostgreSQL
POSTGRES_PASSWORD=ardalink_dev_only

# Multi-tenant
JWT_SECRET=replace-with-32-plus-bytes-random
TENANT_ATTESTATION_SECRET=replace-with-32-plus-bytes-random-shared-with-engine
SESSION_SECRET=replace-with-32-plus-bytes-random

# Supabase — the REAL production data store (wards, pastoralists,
# water_nodes ground truth, whatsapp_messages). Required for any
# herder-facing feature to use real (not stale local-mirror) data.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Africa's Talking (use sandbox for dev)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_CALLER_ID=+254700000000

# WhatsApp — pick a provider via WA_PROVIDER. Left UNSET here
# deliberately: compose.yml (local dev) defaults to 360dialog when
# unset, compose.prod.yml (hand-off stack, Evolution bundled by
# default) defaults to evolution when unset — setting a hardcoded
# value here would silently override whichever file's own default you
# actually want. Set explicitly only if you need to override that
# file's default.
WA_PROVIDER=
THREESIXTYDIALOG_API_KEY=
THREESIXTYDIALOG_PHONE_NUMBER_ID=
# Evolution API — used whenever WA_PROVIDER=evolution (compose.prod.yml's
# default) or the "evolution" compose profile is running under
# compose.yml (see README.md). CHANGE both of these before any real
# deployment — the defaults are dev-only placeholders.
EVOLUTION_POSTGRES_PASSWORD=evolution_dev_only
EVOLUTION_API_KEY=dev_only_change_me
EVOLUTION_INSTANCE_NAME=ardalink-dev

# Azure OpenAI (optional in dev; required for voice calls)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
# AZURE_OPENAI_DEPLOYMENT is the ENGINE's own deployment name (Python
# side). The API (Node side) reads three SEPARATE deployment-name vars
# below — different services, different Azure OpenAI deployments, easy
# to miss since they all default to a plausible-looking name. If your
# actual Azure OpenAI resource doesn't literally have deployments named
# "gpt-4o"/"whisper"/"gpt-4o-realtime-preview", override these three or
# API calls will silently 404 against a deployment name that isn't real.
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-4o-realtime-preview

# Azure Speech — TTS/STT for the voice call-back path (optional; voice
# features degrade gracefully without it)
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Extra trusted origins for the Azure Realtime WebSocket bridge — set
# to this deployment's own public domain (comma-separated hostnames).
# localhost and known tunnel providers (ngrok, Cloudflare, etc.) are
# trusted by default without this — see src/lib/originGuard.ts.
TRUSTED_ORIGIN_HOSTS=

# Google Earth Engine (optional in dev; required for live satellite ingest)
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY=
GEE_PROJECT=

# A full Google service-account JSON blob (one line, e.g.
# {"type":"service_account",...,"private_key":"-----BEGIN PRIVATE
# KEY-----\n...\n-----END PRIVATE KEY-----\n",...}) — used by the API
# (src/lib/satellite.ts), separate from the three GEE_* vars above
# (engine-side). NOTE if deploying via systemd's EnvironmentFile=
# instead of Docker: that parser mangles the escaped "\n" sequences
# inside the PEM private_key, corrupting it (Earth Engine auth then
# fails with an opaque OpenSSL "DECODER routines::unsupported" error).
# Docker Compose's `environment:` block does not have this problem —
# only relevant if you're adapting this for a non-Docker deploy.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Historical baselines now live in the engine's Postgres
# (`gis_engine.baseline_*`); the Azure Cosmos DB client was retired
# 2026-07 and no COSMOS_DB_* env vars are read.

# Scheduler (off in dev)
INGEST_SCHEDULER_ENABLED=0

# Logging
LOG_LEVEL=INFO
