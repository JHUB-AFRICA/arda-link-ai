{
  "name": "ardalink-api",
  "version": "0.2.0",
  "private": true,
  "description": "ArdaLink API — voice, intelligence pipeline, ground-truth capture.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "preinstall": "sh -c 'case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm\" >&2; exit 1 ;; esac'",
    "dev": "tsx watch src/index.ts",
    "build": "pnpm run typecheck && esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.mjs --external:@node-rs/* --external:better-sqlite3 --external:esbuild",
    "start": "node dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'eslint not yet configured' && exit 1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "vci-backfill": "tsx scripts/run-vci-backfill.ts"
  },
  "dependencies": {
    "@google/earthengine": "^1.7.36",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.0",
    "express": "^5.0.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^11.3.0",
    "ws": "^8.21.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^2.1.0",
    "drizzle-kit": "^0.31.9",
    "esbuild": "^0.28.1",
    "eslint": "^9.18.0",
    "prettier": "^3.9.6",
    "supertest": "^7.0.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "vitest": "^2.1.0"
  }
}