# ArdaLink local-dev environment template
# Copy to .env and fill in real values. .env is gitignored.
#
# IMPORTANT: var names below match the code. If a var is named
# differently in code (e.g. AZURE_OPENAI_KEY vs AZURE_OPENAI_API_KEY),
# the code wins — keep this file in sync with src/lib/llm/,
# src/lib/openai.ts, and src/lib/satellite.ts.

# --- Postgres (local dev defaults shown — change for any non-dev use) ---
POSTGRES_PASSWORD=ardalink_dev_only
POSTGRES_PORT=15432

# --- JWT signing secret (HS256) ---
# MUST be at least 32 bytes. Production should rotate regularly.
JWT_SECRET=replace-with-32-plus-bytes-random

# --- HMAC attestation between ardalink-api and ardalink-engine ---
# MUST match between the two services. Same length requirement as JWT_SECRET.
TENANT_ATTESTATION_SECRET=replace-with-32-plus-bytes-random-shared-with-engine

# --- Session signing secret (used by ardalink-api) ---
SESSION_SECRET=replace-with-32-plus-bytes-random

# --- LLM provider layer (ardalink-api/src/lib/llm/) ---
# Two providers at launch: z.ai (GLM) primary, minimax fallback.
# Either or both keys can be unset — unset keys fall back to MockClient
# so the demo and tests pass without network access.
#
# Get a free z.ai key at https://z.ai (GLM-4.5-Flash is free).
ZAI_API_KEY=
ZAI_DEFAULT_MODEL=glm-4.5-flash
#
# minimax M3 is paid (no free tier). Leave blank to use MockClient.
MINIMAX_API_KEY=
MINIMAX_DEFAULT_MODEL=MiniMax-M3

# LLM behavior
LLM_PRIMARY_PROVIDER=z                # z | minimax
LLM_FALLBACK_PROVIDER=minimax         # z | minimax
LLM_TIMEOUT_MS=15000
LLM_CACHE_TTL_SECONDS=300
LLM_DAILY_TOKEN_BUDGET=100000

# --- Optional: external services (leave blank for local demo) ---
# Africa's Talking (sandbox for dev)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_CALLER_ID=+254700000000
AFRICASTALKING_RECIPIENT_PHONE=+254700000000

# Azure OpenAI (existing voice + Realtime integration; the LLM
# layer above does NOT depend on this — the chat/talk-chat routes
# still POST here for the legacy path. The two paths coexist.)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-4o-realtime-preview
AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper

# Google Earth Engine (single JSON-blob service account; required for
# the satellite /api/trigger-check path. In dev, leave unset and
# trigger-check returns 500 — that's expected, the rest of the stack
# works without it.)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Earth Engine / satellite project
GEE_PROJECT=earthengine-legacy

# Local-zone override for satellite query (optional)
LOCAL_ZONE_LAT=
LOCAL_ZONE_LON=
LOCAL_ZONE_RADIUS_KM=5

# Azure Cosmos DB (baseline reference data; required for satellite
# pipeline, not for ground-truth brief or chat)
COSMOS_DB_ENDPOINT=
COSMOS_DB_PRIMARY_KEY=
