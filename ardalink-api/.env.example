# ArdaLink API — environment template
# Copy to .env and fill in. Never commit .env.

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database — PostgreSQL (operational data + local mirror of Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/ardalink

# Supabase — source of truth for reference and operational data.
# Service-role secret; must never reach the browser. Reads try Supabase
# first and fall back to the local DATABASE_URL mirror.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-key

# Historical baselines (NDVI/NDRE per-pixel + aggregate) now live in the
# engine's Postgres (`gis_engine.baseline_*` tables) reached over HTTP.
# The legacy Azure Cosmos DB client was retired 2026-07 — no COSMOS_DB_*
# env vars are read anywhere in the codebase.

# Azure AI Foundry (chat completions + Realtime voice)
# FOUNDRY_ENDPOINT is the full project URL from the Foundry console (has
# /api/projects/<name> suffix). AZURE_OPENAI_ENDPOINT is the resource root
# used by the classic Azure OpenAI URL shapes.
AZURE_OPENAI_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/
AZURE_OPENAI_API_KEY=your-foundry-api-key
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_CHAT_API_VERSION=2024-10-21
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_REALTIME_API_VERSION=2025-04-01-preview

# LLM routing — set 'azure' to make Foundry primary, keep 'z' as fallback.
LLM_PRIMARY_PROVIDER=azure
LLM_FALLBACK_PROVIDER=z

# Azure Speech (Cognitive Services Speech) — STT / TTS / browser token
AZURE_SPEECH_KEY=your-speech-key
AZURE_SPEECH_KEY_SECONDARY=your-speech-key-2
AZURE_SPEECH_REGION=southafricanorth
AZURE_SPEECH_ENDPOINT=https://southafricanorth.api.cognitive.microsoft.com/
AZURE_SPEECH_TTS_VOICE_SW=sw-KE-ZuriNeural
AZURE_SPEECH_TTS_VOICE_EN=en-KE-AsiliaNeural
AZURE_SPEECH_STT_LANGUAGES=sw-KE,en-KE

# Google Earth Engine (single-line JSON)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Africa's Talking
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your-africastalking-api-key
AFRICASTALKING_CALLER_ID=+254711082200

# App
RECIPIENT_PHONE=+254700000000
SESSION_SECRET=your-random-session-secret-here

# Optional rate limits
PUBLIC_TALK_DAILY_BUDGET_MINUTES=30
PUBLIC_TALK_MAX_CALLS_PER_PHONE=3
PUBLIC_TALK_MAX_CALLS_PER_IP=10
TALK_CHAT_MAX_MSGS_PER_IP=50
TALK_CHAT_PER_IP_COOLDOWN_MS=60000

# Optional location defaults (Bula Pesa Ward)
WARD_CLIMATE_LAT=0.355
WARD_CLIMATE_LON=37.583
LOCAL_ZONE_LAT=0.355
LOCAL_ZONE_LON=37.583
LOCAL_ZONE_RADIUS_KM=5